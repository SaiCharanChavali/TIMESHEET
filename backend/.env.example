# Local database, started by `npm run dev` and stored in database/data. Point this at your cloud database in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/timesheet
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000
# Where the React app lives. Used for CORS and for password reset links.
CLIENT_URL=http://localhost:5015
# Decides which calendar day a check-in belongs to and whether someone is late.
OFFICE_TIMEZONE=Asia/Kolkata
NODE_ENV=development
# Passwords given to the demo accounts by the seed script. Development only.
SEED_PASSWORD=ChangeMe123!
SEED_ADMIN_PASSWORD=Admin123
# Email for alerts and password resets. Leave SMTP_HOST empty to keep email off: notifications still
# appear in the app, and in development the emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465. Port 587 upgrades to TLS with STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShimentoX Timesheet <no-reply@example.com>
# How often background jobs, such as forgotten check-out alerts, run. 0 turns them off.
JOB_INTERVAL_SECONDS=60
