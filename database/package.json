{
  "name": "timesheet-database",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx scripts/dev-db.ts",
    "setup": "tsx scripts/setup-db.ts",
    "migrate": "prisma migrate dev && prisma generate",
    "generate": "prisma generate",
    "seed": "tsx --env-file=../backend/.env seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^7.0.2"
  }
}
